#!/bin/sh
# software-factory launcher: runs the factory CLI of the repository you are in.
# Installed by `factory cli install`; remove with `factory cli uninstall`. It holds no logic of its
# own: it finds the nearest .factory/bin/factory above the current folder, so every repository
# keeps using the factory version it was initialised with.
d=$(pwd -P)
while :; do
  if [ -f "$d/.factory/bin/factory" ]; then
    exec python3 "$d/.factory/bin/factory" "$@"
  fi
  [ "$d" = "/" ] && break
  d=$(dirname "$d")
done
echo "factory: this folder is not inside a repository with the software factory installed." >&2
echo "         Run /factory:init in Claude Code there first (or use the plugin's bin/factory directly)." >&2
exit 1
